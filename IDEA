MOD = 0x10001
MASK = 0xFFFF


def mul(a, b):
    # множення по модулю 65537
    if a == 0:
        a = 0x10000
    if b == 0:
        b = 0x10000

    res = (a * b) % MOD

    if res == 0x10000:
        return 0

    return res & MASK


def add(a, b):
    # додавання по модулю 2^16
    return (a + b) & MASK


def add_inv(x):
    # обернене для додавання
    return (-x) & MASK


def mul_inv(x):
    # обернене для множення (алгоритм Евкліда)
    if x == 0:
        x = 0x10000

    t0, t1 = 0, 1
    r0, r1 = MOD, x

    while r1 != 0:
        q = r0 // r1
        r0, r1 = r1, r0 - q * r1
        t0, t1 = t1, t0 - q * t1

    if t0 < 0:
        t0 += MOD

    if t0 == 0x10000:
        return 0

    return t0 & MASK


def generate_encrypt_subkeys(key):
    # 52 підключі по 16 біт
    subkeys = []

    for i in range(52):

        # кожні 8 — циклічний зсув
        if i != 0 and i % 8 == 0:
            key = ((key << 25) | (key >> (128 - 25))) & ((1 << 128) - 1)

        shift = 128 - 16 * ((i % 8) + 1)
        subkeys.append((key >> shift) & 0xFFFF)

    return subkeys


def generate_decrypt_subkeys(enc_keys):
    # генеруємо ключі для дешифрування
    dec = [0] * 52

    dec[0] = mul_inv(enc_keys[48])
    dec[1] = add_inv(enc_keys[49])
    dec[2] = add_inv(enc_keys[50])
    dec[3] = mul_inv(enc_keys[51])
    dec[4] = enc_keys[46]
    dec[5] = enc_keys[47]

    j = 6

    for i in range(42, -1, -6):
        dec[j] = mul_inv(enc_keys[i])
        dec[j + 1] = add_inv(enc_keys[i + 2])
        dec[j + 2] = add_inv(enc_keys[i + 1])
        dec[j + 3] = mul_inv(enc_keys[i + 3])

        if i == 0:
            break

        dec[j + 4] = enc_keys[i - 2]
        dec[j + 5] = enc_keys[i - 1]

        j += 6

    return dec

def idea_round(x1, x2, x3, x4, keys):
    k1, k2, k3, k4, k5, k6 = keys

    x1 = mul(x1, k1)
    x2 = add(x2, k2)
    x3 = add(x3, k3)
    x4 = mul(x4, k4)

    t0 = x1 ^ x3
    t1 = x2 ^ x4

    t0 = mul(t0, k5)
    t1 = add(t1, t0)
    t1 = mul(t1, k6)
    t0 = add(t0, t1)

    y1 = x1 ^ t1
    y4 = x4 ^ t0
    y2 = x3 ^ t1
    y3 = x2 ^ t0

    return y1, y2, y3, y4


def idea_crypt_block(block, subkeys):
    x1 = (block >> 48) & 0xFFFF
    x2 = (block >> 32) & 0xFFFF
    x3 = (block >> 16) & 0xFFFF
    x4 = block & 0xFFFF

    pos = 0

    for _ in range(8):
        x1, x2, x3, x4 = idea_round(
            x1, x2, x3, x4,
            subkeys[pos:pos + 6]
        )
        pos += 6

    y1 = mul(x1, subkeys[48])
    y2 = add(x3, subkeys[49])
    y3 = add(x2, subkeys[50])
    y4 = mul(x4, subkeys[51])

    return (y1 << 48) | (y2 << 32) | (y3 << 16) | y4


def encrypt_block(block, key):
    enc_keys = generate_encrypt_subkeys(key)
    return idea_crypt_block(block, enc_keys)


def decrypt_block(block, key):
    enc_keys = generate_encrypt_subkeys(key)
    dec_keys = generate_decrypt_subkeys(enc_keys)
    return idea_crypt_block(block, dec_keys)


